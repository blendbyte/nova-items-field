{
    "name": "blendbyte/nova-items-field",
    "description": "Array items field for Laravel Nova with drag/drop sorting, validation & flexible display options. Fork of dillingham/nova-items-field, maintained for Nova 5.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/nova": "^5.0",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "NovaItemsField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NovaItemsField\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
